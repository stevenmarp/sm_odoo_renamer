<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="privilege_renamer" model="res.groups.privilege">
        <field name="name">Odoo Renamer</field>
        <field name="category_id" ref="base.module_category_extra_tools"/>
    </record>

    <record id="group_renamer_manager" model="res.groups">
        <field name="name">Renamer Manager</field>
        <field name="privilege_id" ref="privilege_renamer"/>
        <field name="comment">Users allowed to manage rename rules for field labels, buttons and tabs.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_renamer_manager'))]"/>
    </record>
</odoo>
